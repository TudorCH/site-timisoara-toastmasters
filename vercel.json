{
  "buildCommand": "npm install && npm run build:css",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/home.html",       "destination": "/",          "permanent": true },
    { "source": "/contact.html",    "destination": "/contact",   "permanent": true },
    { "source": "/galerie.html",    "destination": "/galerie",   "permanent": true },
    { "source": "/despre-noi.html", "destination": "/despre-noi","permanent": true },
    { "source": "/cookies.html",    "destination": "/cookies",   "permanent": true }
  ],
  "rewrites": [
    { "source": "/",           "destination": "/home.html"      },
    { "source": "/contact",    "destination": "/contact.html"   },
    { "source": "/galerie",    "destination": "/galerie.html"   },
    { "source": "/despre-noi", "destination": "/despre-noi.html"},
    { "source": "/cookies",    "destination": "/cookies.html"   }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" }
      ]
    }
  ]
}
