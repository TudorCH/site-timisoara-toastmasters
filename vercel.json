{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/home.html",       "destination": "/",          "permanent": true },
    { "source": "/contact.html",    "destination": "/contact",   "permanent": true },
    { "source": "/galerie.html",    "destination": "/galerie",   "permanent": true },
    { "source": "/despre-noi.html", "destination": "/despre-noi","permanent": true },
    { "source": "/cookies.html",    "destination": "/cookies",   "permanent": true },
    { "source": "/blog.html",       "destination": "/blog",      "permanent": true },
    { "source": "/links.html",      "destination": "/links",     "permanent": true },
    { "source": "/bio",             "destination": "/links",     "permanent": false }
  ],
  "rewrites": [
    { "source": "/",           "destination": "/home.html"      },
    { "source": "/contact",    "destination": "/contact.html"   },
    { "source": "/galerie",    "destination": "/galerie.html"   },
    { "source": "/despre-noi", "destination": "/despre-noi.html"},
    { "source": "/cookies",    "destination": "/cookies.html"   },
    { "source": "/blog",       "destination": "/blog.html"      },
    { "source": "/links",      "destination": "/links.html"     },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/api/gh/:path*", "destination": "/api/gh?path=:path*" },
    { "source": "/admin",      "destination": "/admin/index.html" },
    { "source": "/admin/stats", "destination": "/admin/stats.html" },
    { "source": "/admin/agenda", "destination": "/admin/agenda.html" },
    { "source": "/admin/ecusoane", "destination": "/admin/ecusoane.html" },
    { "source": "/admin/membri", "destination": "/admin/membri.html" },
    { "source": "/membri", "destination": "/membri.html" }
  ],
  "functions": {
    "api/*.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" }
      ]
    }
  ]
}
